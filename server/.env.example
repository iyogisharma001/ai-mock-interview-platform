# --- Server ---
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# --- Data stores ---
MONGO_URI=mongodb://127.0.0.1:27017/mock_interview
REDIS_URL=redis://127.0.0.1:6379

# --- AI interviewer ---
# auto  = use Claude when credentials are present, otherwise the built-in rule-based interviewer
# live  = require Claude      mock = never call the API
AI_MODE=auto
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# --- Workers ---
# true = run BullMQ workers inside the API process (dev). false = run `npm run worker` separately.
RUN_WORKERS_INLINE=true
EXECUTION_CONCURRENCY=4
REPORT_CONCURRENCY=2

# --- Sandbox ---
SANDBOX_IMAGE_PYTHON=python:3.10-slim
SANDBOX_IMAGE_JAVASCRIPT=node:18-alpine
SANDBOX_IMAGE_CPP=gcc:13
# C++ is compiled in a separate container with its own, more generous limits.
SANDBOX_COMPILE_TIMEOUT_MS=20000
SANDBOX_COMPILE_MEMORY_MB=512
SANDBOX_COMPILE_CPUS=1
SANDBOX_TIMEOUT_MS=5000
SANDBOX_MEMORY_MB=128
SANDBOX_CPUS=0.5
SANDBOX_AUTO_PULL=true
# Host directory for per-run workspaces (must be bind-mountable by the Docker daemon). Defaults to the OS temp dir.
SANDBOX_WORKDIR=
