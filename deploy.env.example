# Copy to deploy.env on the server. Never commit the real file.

# Public hostname of the backend. Its DNS A record must point at this server.
API_DOMAIN=api.example.com

# URL of the hosted client, exactly as the browser shows it (no trailing slash).
# Several origins can be listed, separated by commas.
CLIENT_ORIGIN=https://your-app.vercel.app

# Optional: a Google Gemini API key (https://aistudio.google.com/apikey) enables the AI interviewer.
# Without it the rule-based interviewer is used. Never commit the real key.
GEMINI_API_KEY=
AI_MODEL=gemini-3.8-flash
AI_MODE=auto
